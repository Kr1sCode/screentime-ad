[Unit]
Description=screentime-ad web UI
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/screentime-ad
ExecStart=/opt/screentime-ad/venv/bin/gunicorn -w 2 -b 0.0.0.0:80 --timeout 120 web:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
